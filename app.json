{
  "expo": {
    "name": "Click & Serve",
    "slug": "click-serve-movil",
    "scheme": "click-serve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que Click & Serve use la cámara para verificar tu identidad."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que Click & Serve adjunte fotos del problema al solicitar un servicio."
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "TU_API_KEY_AQUI"
        }
      },
      "package": "com.gallo122.clickservemovil"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6c536d8-cc7b-46fa-974a-4ad6dd7a4932"
      }
    }
  }
}
